# Local development only. Do not commit a real .env or secrets.toml.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# Optional providers; each requires its own key.
# OPENAI_API_KEY=replace-with-your-openai-key
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key
APP_PASSWORD=replace-with-a-long-random-password
REQUIRE_APP_PASSWORD=true
API_CALLS_PER_HOUR=200
API_CALLS_PER_DAY=1000
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=2048
# Both the app and bot must use the same path on the same host.
# DISPATCH_DB_PATH=/absolute/path/on-a-durable-volume/dispatch.sqlite3
# Shared cloud database: set the SAME URI in web and Telegram deployments.
# Run database/supabase_schema.sql once first. Keep this URI server-side only.
# Prefer the Supabase Session pooler URI for IPv4 connections.
# DISPATCH_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Alternatively omit the password from the URI and set it separately, unencoded:
# DISPATCH_DATABASE_PASSWORD="your-database-password"
# TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
